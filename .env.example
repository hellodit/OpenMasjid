# ─── Postgres (Supabase or any Postgres 15+) ─────────────────────────────────
# Runtime connection used by the app (server-side queries via Drizzle).
# MUST be the restricted role from server/db/sql/0001_app_role.sql (no BYPASSRLS),
# otherwise Row Level Security — the database-level tenant isolation — is bypassed.
# On Supabase use the **Transaction pooler** URL (port 6543, PgBouncer).
DATABASE_URL=postgres://openmasjid_app.<project-ref>:<app-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Direct/session connection used by drizzle-kit (generate/migrate/studio), seeds and the
# isolation test cleanup. Owner role (e.g. `postgres`).
# On Supabase: Project Settings → Database → Connection string → "Direct" (port 5432).
DATABASE_DIRECT_URL=postgres://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# Max connections per server instance (keep low on serverless).
DATABASE_POOL_MAX=5

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app (used for callbacks, reset-password links, CSRF).
BETTER_AUTH_URL=http://localhost:3000
# Optional extra allowed origins, comma separated.
BETTER_AUTH_TRUSTED_ORIGINS=

# ─── Seed (bun run db:seed) ──────────────────────────────────────────────────
# Creates one mosque (tenant) at /<SEED_TENANT_SLUG> and its owner account
# (through Better Auth, password hashed). New mosques normally sign up at /daftar.
SEED_TENANT_SLUG=al-hikmah
SEED_TENANT_NAME=Masjid Al-Hikmah
SEED_ADMIN_EMAIL=admin@masjid.id
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin DKM

# ─── Scheduler (optional) ────────────────────────────────────────────────────
# Long-running worker that runs scheduled tasks (see scripts/scheduler.ts).
# Mainly used as a keep-alive ping so Supabase free-tier doesn't auto-pause.
SCHEDULER_HEALTH_CRON=0 */6 * * *
SCHEDULER_TZ=Asia/Jakarta
