# ─── Supabase Postgres ───────────────────────────────────────────────────────
# Runtime connection used by the app (server-side queries via Drizzle).
# Use the Supabase **Transaction pooler** URL (port 6543, PgBouncer).
# Supabase dashboard → Project Settings → Database → Connection string → "Transaction"
DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Direct/session connection used by drizzle-kit (migrate, push, studio) and seed.
# Required because drizzle-kit needs session-level features (advisory locks, DDL).
# Supabase dashboard → Project Settings → Database → Connection string → "Direct"
DATABASE_DIRECT_URL=postgres://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Supabase Auth (client-exposed) ──────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# ─── Seed config ─────────────────────────────────────────────────────────────
# UUID of the Supabase Auth user that should be promoted to role='admin' in
# the public.users table. Create the user first via Supabase Auth dashboard,
# then copy its UUID here. Leave blank to skip admin promotion during seed.
ADMIN_USER_ID=
